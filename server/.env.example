# Backend only. Never prefix these with VITE_. Rotate any previously committed keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Firebase Authentication UID(s), comma-separated. Not email addresses.
RAZORPAY_ADMIN_UIDS=
# Local Firebase Admin application credentials; use workload identity in hosting.
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8080
