# --- FAMPAY PAYMENT GATEWAY & UPI INTEGRATION ---
# Provider-Independent Architecture supporting FamPay Merchant APIs & SDKs
FAMPAY_API_KEY=
FAMPAY_API_SECRET=
FAMPAY_WEBHOOK_SECRET=whsec_fampay_webhook_secret_demo
