# --- MERCHANT BANK SETTLEMENT NOTE ---
# Owner supplied UPI: priyan1436ei@okhdfcbank
# NOTE: Razorpay collections settle directly to the bank account verified in your
# Razorpay Merchant Dashboard (Settings -> Bank Account), NOT automatically to an arbitrary UPI ID.

# --- TRANSACTIONAL EMAIL PROVIDER ---
# If SMTP is configured, invitation emails will be dispatched via real SMTP.
# If omitted, FinFam operates in Sandbox Mode (emails captured to internal outbox & viewable via /api/email/inbox).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="FinFam Vault" <invitations@finfam.cloud>

# Optional email failure simulation for testing:
SIMULATE_EMAIL_FAILURES=false

# --- P2P FAMILY MONEY TRANSFERS ---
# Direct member-to-member money movement requires a dedicated P2P banking switch / UPI DeepLink partner
# (such as Decentro, Setu, or Cashfree Payouts). Razorpay merchant checkout cannot do arbitrary P2P payouts.
ENABLE_P2P_BANKING_SWITCH=false

# --- FIREBASE / GOOGLE CLOUD (OPTIONAL) ---
# Optional: Path to service-account.json. If not provided, in-memory reactive store is used.
GOOGLE_APPLICATION_CREDENTIALS=

# --- GEMINI AI ADVISOR ---
GEMINI_API_KEY=
